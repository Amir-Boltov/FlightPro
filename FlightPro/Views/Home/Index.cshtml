@using FlightPro.Models
@model Tuple<List<PackageModel>, List<PackageReviewModel>>

@{
    ViewData["Title"] = "Welcome";
    var hotDeals = Model.Item1;
    var reviews = Model.Item2;
}

<div class="hero-section">
    <div class="container">
        <h1 class="display-3 fw-bold">Find Your Next Adventure</h1>
        <p class="lead mb-4">Search low fares to destinations around the world.</p>

        <div class="row justify-content-center mt-5">
            <div class="col-md-8">
                <form action="/Trips/Index" method="get" class="glass-search p-2 rounded-pill shadow-lg">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-0">
                            <i class="bi bi-geo-alt text-white"></i>
                        </span>
                        <input type="text" name="search" class="form-control border-0 text-white"
                               placeholder="Where to? (e.g. Paris)" aria-label="Search">
                        <button class="btn btn-warning rounded-pill px-4 fw-bold" type="submit">Search</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">🔥 Hot Deals This Week</h2>
        <a href="/Trips" class="btn btn-outline-dark">View All Trips</a>
    </div>

    <div class="row">
        @foreach (var item in hotDeals)
        {
            <div class="col-md-4 mb-4">
                <div class="card trip-card h-100 shadow-sm">
                    <div class="position-relative">
                        <a href="/Trips/Details/@item.Id">
                            <img src="@item.MainImageUrl" class="card-img-top" alt="@item.Title" style="height: 200px; object-fit: cover;">
                        </a>
                        @if (item.DisplayDiscountedPrice.HasValue)
                        {
                            <span class="position-absolute top-0 end-0 bg-warning text-black px-3 py-1 m-2 rounded-pill fw-bold">
                                SAVE $@((item.DisplayPrice - item.DisplayDiscountedPrice.Value).ToString("0"))
                            </span>
                        }
                    </div>
                    <div class="card-body">
                        <p class="text-uppercase text-muted small mb-1 fw-bold">@item.Destination, @item.Country</p>
                        <h5 class="card-title fw-bold">@item.Title</h5>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <div>
                                <span class="text-decoration-line-through text-muted">$@item.DisplayPrice.ToString("N0")</span>
                                @if (item.DisplayDiscountedPrice.HasValue)
                                {
                                    <span class="h4 text-danger fw-bold ms-2">$@item.DisplayDiscountedPrice.Value.ToString("N0")</span>
                                }
                            </div>
                            <a href="/Trips/Details/@item.Id" class="btn btn-warning rounded-pill btn-sm">View Deal</a>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (!hotDeals.Any())
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted">No hot deals available right now.</p>
            </div>
        }
    </div>

    <hr class="my-5" />

    <div class="row mb-5 text-center">
        <div class="col-md-4">
            <div class="feature-box p-3">
                <i class="bi bi-check-circle-fill text-success fs-1"></i>
                <h4 class="mt-3">Easy Booking</h4>
                <p class="text-muted">Book your dream trip in just 3 clicks.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-box p-3">
                <i class="bi bi-shield-lock-fill text-primary fs-1"></i>
                <h4 class="mt-3">Secure Payment</h4>
                <p class="text-muted">We use top-tier SSL encryption.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-box p-3">
                <i class="bi bi-globe-americas text-info fs-1"></i>
                <h4 class="mt-3">Top Destinations</h4>
                <p class="text-muted">Access to exclusive locations.</p>
            </div>
        </div>
    </div>

    <hr class="my-5" />

    <div class="reviews-section mb-5">
        <div class="text-center mb-5">
            <h2 class="fw-bold">What Our Travelers Say</h2>
            <p class="text-muted">Latest reviews from our community</p>
        </div>

        <div class="row">
            @foreach (var review in reviews)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 border-0 shadow-sm" style="background-color: #fffbe6;">
                        <div class="card-body p-4">
                            <div class="mb-3 text-warning">
                                @for (int i = 0; i < review.Rating; i++)
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                                @for (int i = review.Rating; i < 5; i++)
                                {
                                    <i class="bi bi-star"></i>
                                }
                            </div>
                            <p class="card-text fst-italic text-dark">"@review.Comment"</p>
                            <div class="d-flex align-items-center mt-4">
                                <div class="bg-warning text-dark fw-bold rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    @review.UserName.Substring(0, 1).ToUpper()
                                </div>
                                <div class="ms-3">
                                    <h6 class="mb-0 fw-bold text-dark">@review.UserName</h6>
                                    <small class="text-muted">@review.Date.ToString("MMM dd, yyyy")</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (!reviews.Any())
            {
                <div class="col-12 text-center">
                    <p class="text-muted">No reviews yet.</p>
                </div>
            }
        </div>
    </div>

</div>