@model List<FlightPro.Models.myBook>

@{
    ViewData["Title"] = "My Cart";
    decimal grandTotal = Model.Sum(x => x.TotalPrice ?? 0);
    int itemCount = Model.Count;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<style>
    body {
        background-color: #f8f9fa;
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    /* Enhanced Flight Card */
    .flight-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.03);
        background: white;
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s;
        margin-bottom: 24px;
    }

        .flight-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        }

    .destination-img {
        height: 100%;
        min-height: 200px;
        object-fit: cover;
        width: 100%;
    }

    /* Price Section Styling */
    .price-section {
        background-color: #fcfcfc;
        border-left: 1px solid #f0f0f0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-end;
        padding: 20px;
        height: 100%;
    }

    .price-tag {
        font-size: 1.6rem;
        font-weight: 800;
        color: #2c3e50;
        line-height: 1;
    }

    .price-breakdown {
        font-size: 0.85rem;
        color: #6c757d;
        margin-bottom: 4px;
    }

    .info-section {
        padding: 20px;
    }

    .detail-item {
        display: flex;
        align-items: center;
        margin-bottom: 8px;
        color: #555;
        font-size: 0.95rem;
    }

        .detail-item i {
            width: 25px;
            text-align: center;
            margin-right: 8px;
        }

    /* Timer Badge Styling */
    .timer-badge {
        font-size: 0.85rem;
        font-weight: 600;
        padding: 5px 10px;
        border-radius: 6px;
        background-color: #e9ecef;
        color: #495057;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.3s ease;
    }

        .timer-badge.urgent {
            background-color: #fee2e2;
            color: #dc2626;
            animation: pulse 2s infinite;
        }

    @* Simple pulse animation for urgent timers *@
    @("@keyframes") pulse {
        0%

    {
        opacity: 1;
    }

    50% {
        opacity: 0.7;
    }

    100% {
        opacity: 1;
    }

    }

    /* Summary Card */
    .summary-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        border: none;
        position: sticky;
        top: 20px;
    }

    .btn-checkout {
        background: #0d6efd;
        border: none;
        padding: 14px;
        border-radius: 10px;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

        .btn-checkout:hover {
            background: #0b5ed7;
        }
</style>

<div class="container py-5">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert" style="border-radius: 12px; border-left: 5px solid #dc3545;">
            <div class="d-flex align-items-center">
                <i class="fas fa-exclamation-circle fa-2x me-3 text-danger"></i>
                <div>
                    <h5 class="alert-heading fw-bold mb-1">Limit Reached</h5>
                    <p class="mb-0">@TempData["Error"]</p>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold text-dark mb-1">Your Shopping Cart</h2>
            <p class="text-muted">Review your trips before checkout</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-light text-center py-5 shadow-sm border-0" style="background: white; border-radius: 16px;">
            <div class="mb-3">
                <i class="fas fa-suitcase-rolling fa-3x text-muted opacity-50"></i>
            </div>
            <h4>Your cart is empty</h4>
            <p class="text-muted mb-4">Time to start planning your next adventure!</p>
            <a href="/Trips/Index" class="btn btn-primary px-4 rounded-pill">Explore Trips</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">

                @foreach (var item in Model)
                {
                    // Calculations
                    decimal total = item.TotalPrice ?? 0;
                    int amount = item.Amount ?? 1;
                    decimal unitPrice = amount > 0 ? total / amount : 0;

                    <div class="flight-card">
                        <div class="row g-0 h-100">

                            <div class="col-md-3">
                                <img src="@item.Package.MainImageUrl" class="destination-img" alt="@item.Package.Title">
                            </div>

                            <div class="col-md-6">
                                <div class="info-section h-100 d-flex flex-column justify-content-center">
                                    @if (item.Status == "Reserved")
                                    {
                                        <div class="mb-3">
                                            <div class="p-2 px-3 rounded-3" style="background-color: #ecfdf5; border: 1px solid #a7f3d0; color: #047857;">
                                                <div class="d-flex align-items-center">
                                                    <i class="fas fa-check-circle me-2 fs-5"></i>
                                                    <div style="line-height: 1.2;">
                                                        <div class="fw-bold" style="font-size: 0.9rem;">Waitlist Spot Available!</div>
                                                        <div class="small opacity-75">This trip is reserved for you.</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h4 class="fw-bold mb-0 text-dark">@item.Package.Title</h4>
                                    </div>

                                    @* --- TIMER SECTION START --- *@
                                    <div class="mb-3">
                                        <div class="timer-badge" id="timer-box-@item.Id">
                                            <i class="far fa-clock"></i>
                                            <span>Expires in:</span>
                                            <span class="countdown-timer" data-seconds="@item.RemainingSeconds" id="timer-val-@item.Id">Calculating...</span>
                                        </div>
                                    </div>
                                    @* --- TIMER SECTION END --- *@

                                    <div class="detail-item">
                                        <i class="fas fa-map-marker-alt text-danger"></i>
                                        <span>@item.Package.Destination</span>
                                    </div>

                                    <div class="detail-item">
                                        <i class="far fa-calendar-alt text-primary"></i>
                                        <span>
                                            @item.PackageDate.StartDate.ToString("MMM dd") - @item.PackageDate.EndDate.ToString("MMM dd, yyyy")
                                        </span>
                                    </div>

                                    <div class="detail-item">
                                        <i class="fas fa-user-friends text-success"></i>
                                        <span>@item.Amount Travelers</span>
                                    </div>

                                    <div class="mt-3">
                                        <a href="/Trips/Details/@item.PackageId" class="text-decoration-none small fw-bold">
                                            View Details <i class="fas fa-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="price-section h-100">

                                    <div class="text-end mb-1">
                                        <span class="badge bg-light text-dark border mb-2">Flight + Hotel</span>
                                    </div>

                                    <div class="price-breakdown">
                                        $@unitPrice.ToString("N0") x @amount
                                    </div>
                                    <div class="price-tag text-primary mb-3">
                                        $@total.ToString("N0")
                                    </div>

                                    <form asp-controller="MyBook" asp-action="RemoveFromBasket" method="post"
                                          onsubmit="return confirm('Remove this trip from cart?');" class="w-100 text-end">
                                        <input type="hidden" name="bookingId" value="@item.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm border-0 rounded-pill px-3">
                                            <i class="fas fa-trash-alt me-1"></i> Remove
                                        </button>
                                    </form>
                                </div>
                            </div>

                        </div>
                    </div>
                }

                <div class="mt-4 mb-5">
                    <a href="/Trips/Index" class="btn btn-white border shadow-sm rounded-pill px-4 py-2 fw-bold text-muted">
                        <i class="fas fa-arrow-left me-2"></i> Keep Browsing
                    </a>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card summary-card p-4">
                    <h5 class="fw-bold mb-4">Order Summary</h5>

                    <div class="mb-3">
                        @foreach (var item in Model)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-2" style="font-size: 0.9rem;">
                                <div class="text-truncate" style="max-width: 180px;">
                                    <span class="fw-bold text-dark">@item.Package.Title</span>
                                    <div class="text-muted small">x @item.Amount travelers</div>
                                </div>
                                <span class="text-dark">$@((item.TotalPrice ?? 0).ToString("N0"))</span>
                            </div>
                        }
                    </div>

                    <hr class="my-3">

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal</span>
                        <span class="fw-bold">$@grandTotal.ToString("N0")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-4 align-items-center p-3 bg-light rounded">
                        <span class="h6 fw-bold text-dark mb-0">Total Due</span>
                        <span class="h4 fw-bold text-primary mb-0">$@grandTotal.ToString("N0")</span>
                    </div>

                    <form action="/Order/Checkout" method="get">
                        <button type="submit" class="btn btn-checkout btn-primary w-100 text-white shadow-sm">
                            Proceed to Checkout
                        </button>
                    </form>

                    <div class="text-center mt-4">
                        <small class="text-muted d-block mb-2">Secure Payment</small>
                        <div class="text-muted fs-4 opacity-75">
                            <i class="fab fa-cc-visa mx-1"></i>
                            <i class="fab fa-cc-mastercard mx-1"></i>
                            <i class="fab fa-cc-amex mx-1"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@* --- JAVASCRIPT FOR TIMER --- *@
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Select all timer elements
        const timers = document.querySelectorAll('.countdown-timer');

        timers.forEach(timer => {
            // Get the initial seconds from the data attribute (calculated by C#)
            let totalSeconds = parseInt(timer.getAttribute('data-seconds'));
            const timerId = timer.id.replace('timer-val-', ''); // Extract Item ID
            const badgeElement = document.getElementById('timer-box-' + timerId);

            // Update the display immediately
            updateDisplay(timer, totalSeconds, badgeElement);

            // Start the interval
            const interval = setInterval(() => {
                totalSeconds--;

                if (totalSeconds <= 0) {
                    clearInterval(interval);
                    timer.textContent = "Expired";
                    // Reload page to let backend clean up the item
                    window.location.reload();
                } else {
                    updateDisplay(timer, totalSeconds, badgeElement);
                }
            }, 1000);
        });

        function updateDisplay(element, seconds, badge) {
            const m = Math.floor(seconds / 60);
            const s = seconds % 60;

            // Format as MM:SS (e.g., 05:09)
            element.textContent = `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;

            // Visual Alert: Turn red if less than 2 minutes (120 seconds)
            if (seconds < 120) {
                if(badge) badge.classList.add('urgent');
            }
        }
    });
</script>