@model List<FlightPro.Models.HistoryViewModel>

@{
    ViewData["Title"] = "My Order History";
    var upcoming = Model.Where(x => x.IsUpcoming).ToList();
    var past = Model.Where(x => !x.IsUpcoming).ToList();
}

<style>
    .history-card {
        border: none;
        border-radius: 15px;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        background: white;
        margin-bottom: 20px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    }

        .history-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

    .card-img-left {
        height: 100%;
        width: 100%;
        object-fit: cover;
        min-height: 200px;
    }

    .status-badge {
        font-size: 0.8rem;
        padding: 5px 12px;
        border-radius: 20px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .status-confirmed {
        background-color: #d1e7dd;
        color: #0f5132;
    }

    .status-canceled {
        background-color: #f8d7da;
        color: #842029;
    }

    .status-completed {
        background-color: #e2e3e5;
        color: #41464b;
    }

    .btn-cancel {
        border: 1px solid #dc3545;
        color: #dc3545;
        background: transparent;
        border-radius: 50px;
        padding: 8px 20px;
        transition: 0.3s;
    }

        .btn-cancel:hover {
            background: #dc3545;
            color: white;
        }
</style>

<div class="container py-5">
    <h2 class="fw-bold mb-4"><i class="bi bi-clock-history me-2"></i> Booking History</h2>

    <ul class="nav nav-tabs mb-4" id="historyTab" role="tablist">
        <li class="nav-item">
            <button class="nav-link active fw-bold" id="upcoming-tab" data-bs-toggle="tab" data-bs-target="#upcoming" type="button">
                Upcoming Trips (@upcoming.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link fw-bold" id="past-tab" data-bs-toggle="tab" data-bs-target="#past" type="button">
                Past Trips (@past.Count)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="historyTabContent">

        <div class="tab-pane fade show active" id="upcoming">
            @if (!upcoming.Any())
            {
                <div class="alert alert-info">You have no upcoming trips booked.</div>
            }

            @foreach (var item in upcoming)
            {
                <div class="history-card row g-0">
                    <div class="col-md-3">
                        <img src="@item.ImageUrl" class="card-img-left" alt="@item.Title">
                    </div>
                    <div class="col-md-9 p-4 d-flex flex-column justify-content-between">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h4 class="fw-bold mb-1">@item.Title</h4>
                                <p class="text-muted mb-2"><i class="bi bi-geo-alt-fill text-primary"></i> @item.Destination</p>
                                <div class="text-muted small">
                                    <i class="bi bi-calendar-event me-1"></i> @item.StartDate.ToShortDateString() - @item.EndDate.ToShortDateString()
                                </div>
                            </div>

                            @if (item.Status == "Canceled")
                            {
                                <span class="status-badge status-canceled">Canceled</span>
                            }
                            else
                            {
                                <span class="status-badge status-confirmed">Confirmed</span>
                            }
                        </div>

                        <div class="d-flex justify-content-between align-items-end mt-3">
                            <div>
                                <small class="text-muted">Total Paid</small>
                                <div class="fs-4 fw-bold">$@item.TotalPrice.ToString("N0")</div>
                            </div>

                            @if (item.Status != "Canceled")
                            {
                                <form asp-action="CancelBooking" method="post" onsubmit="return confirm('Are you sure you want to cancel this trip? This cannot be undone.');">
                                    <input type="hidden" name="bookingId" value="@item.BookingId" />
                                    <button type="submit" class="btn-cancel">
                                        <i class="bi bi-x-circle me-1"></i> Cancel Booking
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="tab-pane fade" id="past">
            @if (!past.Any())
            {
                <div class="text-muted p-4">No past trips found.</div>
            }

            @foreach (var item in past)
            {
                <div class="history-card row g-0 opacity-75">
                    <div class="col-md-3">
                        <img src="@item.ImageUrl" class="card-img-left" style="filter: grayscale(80%);" alt="@item.Title">
                    </div>
                    <div class="col-md-9 p-4">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h5 class="fw-bold">@item.Title</h5>
                                <p class="text-muted mb-1">@item.Destination</p>
                                <small class="text-muted">@item.StartDate.ToShortDateString()</small>
                            </div>
                            <span class="status-badge status-completed">Completed</span>
                        </div>
                        <div class="mt-3 fw-bold text-end text-muted">
                            Paid: $@item.TotalPrice.ToString("N0")
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</div>