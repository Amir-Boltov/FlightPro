@model FlightPro.Models.TripsIndexViewModel
@{
    ViewData["Title"] = "Trips";
}

<div class="container-fluid px-4 mt-4">

    <div class="card shadow-sm mb-4 bg-light">
        <div class="card-body">
            <form method="get" action="@Url.Action("Index")">
                <div class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Search</label>
                        <input type="text" name="searchQuery" class="form-control" placeholder="Search trips..." value="@Model.SearchQuery">
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold">Country</label>
                        <select name="country" class="form-select">
                            <option value="">All Countries</option>
                            @foreach (var c in Model.AllCountries)
                            {
                                <option value="@c" selected="@(Model.SelectedCountry == c)">@c</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold">City</label>
                        <select name="city" class="form-select">
                            <option value="">All Cities</option>
                            @foreach (var c in Model.AllCities)
                            {
                                <option value="@c" selected="@(Model.SelectedCity == c)">@c</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold">Category</label>
                        <select name="category" class="form-select">
                            <option value="">All Categories</option>
                            @foreach (var c in Model.AllCategories)
                            {
                                <option value="@c" selected="@(Model.SelectedCategory == c)">@c</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold">Sort By</label>
                        <select name="sortOrder" class="form-select">
                            <option value="date_asc" selected="@(Model.SortOrder == "date_asc")">Date: Sooner</option>
                            <option value="date_desc" selected="@(Model.SortOrder == "date_desc")">Date: Later</option>
                            <option value="price_asc" selected="@(Model.SortOrder == "price_asc")">Price: Low to High</option>
                            <option value="price_desc" selected="@(Model.SortOrder == "price_desc")">Price: High to Low</option>
                            <option value="popularity" selected="@(Model.SortOrder == "popularity")">Popularity</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold">Min Price</label>
                        <input type="number" name="minPrice" class="form-control form-control-sm" value="@Model.MinPrice">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Max Price</label>
                        <input type="number" name="maxPrice" class="form-control form-control-sm" value="@Model.MaxPrice">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">After Date</label>
                        <input type="date" name="startDate" class="form-control form-control-sm"
                               value="@(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("yyyy-MM-dd") : "")">
                    </div>
                    <div class="col-md-2 pt-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="onlyDiscounted" value="true" checked="@Model.OnlyDiscounted">
                            <label class="form-check-label fw-bold">Discounted</label>
                        </div>
                    </div>
                    <div class="col-md-4 pt-3 text-end">
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary me-2">Reset</a>
                        <button type="submit" class="btn btn-warning px-4">Search Trips</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="row">
        @if (Model.Trips.Count == 0)
        {
            <div class="col-12 text-center py-5">
                <h3 class="text-muted">No trips found matching your criteria.</h3>
            </div>
        }

        @foreach (var item in Model.Trips)
        {
            <div class="col-12 col-md-6 col-lg-3 mb-4 d-flex align-items-stretch">
                <div class="card shadow-sm w-100 border-0 h-100 position-relative card-hover">

                    <a href="/Trips/Details/@item.Id" class="stretched-link"></a>

                    <div class="position-relative">
                        <img src="@item.MainImageUrl" class="card-img-top" alt="@item.Title" style="height: 180px; object-fit: cover;">
                        <span class="position-absolute top-0 start-0 badge bg-warning text-black m-2 shadow-sm">@item.Category</span>
                        <span class="position-absolute top-0 end-0 badge bg-dark m-2 shadow-sm">@(item.MinAge > 0 ? item.MinAge + "+" : "All Ages")</span>
                    </div>

                    <div class="card-body d-flex flex-column">
                        <div class="text-uppercase text-muted small fw-bold mb-1">
                            <i class="bi bi-geo-alt-fill text-danger"></i> @item.Destination, @item.Country
                        </div>
                        <h5 class="card-title fw-bold mb-2">@item.Title</h5>
                        <p class="mb-2 text-secondary" style="font-size: 0.9rem;">
                            <i class="bi bi-calendar3"></i>
                            @if (item.DisplayStartDate.HasValue && item.DisplayEndDate.HasValue)
                            {
                                <span>
                                    @item.DisplayStartDate.Value.ToString("MMM dd, yyyy") - @item.DisplayEndDate.Value.ToString("MMM dd, yyyy")
                                </span>
                            }
                        </p>

                        <div class="mb-3">
                            @{
                                var roomColor = item.DisplayAvailableRooms < 5 ? "text-danger" : "text-success";
                                var roomIcon = item.DisplayAvailableRooms < 5 ? "bi-exclamation-circle" : "bi-check-circle";
                            }
                            <small class="@roomColor fw-bold">
                                <i class="bi @roomIcon"></i> @item.DisplayAvailableRooms rooms left
                            </small>
                        </div>

                        <div class="mt-auto border-top pt-3 d-flex justify-content-between align-items-center">
                            <div>
                                @if (item.DisplayDiscountedPrice.HasValue)
                                {
                                    <div class="text-decoration-line-through text-muted small">$@item.DisplayPrice.ToString("N0")</div>
                                    <div class="text-danger fw-bold fs-5">$@item.DisplayDiscountedPrice.Value.ToString("N0")</div>
                                }
                                else
                                {
                                    <div class="fw-bold fs-5 text-dark">$@item.DisplayPrice.ToString("N0")</div>
                                }
                            </div>

                            <i class="bi bi-chevron-right text-muted"></i>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>