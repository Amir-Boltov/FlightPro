@model FlightPro.Models.TripsIndexViewModel
@{
    ViewData["Title"] = "Explore the World";
    // משתנה עזר לתאריך של היום בפורמט שהדפדפן מבין
    string todayDate = DateTime.Now.ToString("yyyy-MM-dd");
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

<style>
    :root {
        --primary-orange: #FF8C00;
        --primary-yellow: #FFC107;
        --card-bg: #ffffff;
        --bg-gray: #f8f9fa;
        --text-dark: #2c3e50;
    }

    body {
        background-color: var(--bg-gray);
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    /* --- Header Section --- */
    .page-header {
        text-align: center;
        padding: 40px 0 20px;
        color: var(--text-dark);
    }

        .page-header h1 {
            font-weight: 800;
            letter-spacing: -1px;
        }

        .page-header p {
            color: #7f8c8d;
            font-size: 1.1rem;
        }

    /* --- Filter Bar Design --- */
    .search-container {
        background: white;
        padding: 25px;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        margin-bottom: 40px;
        border: 1px solid rgba(0,0,0,0.03);
        transition: transform 0.3s;
    }

        .search-container:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 40px rgba(0,0,0,0.08);
        }

    .form-label {
        font-size: 0.85rem;
        color: #95a5a6;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .form-control, .form-select {
        border: 1px solid #eee;
        background-color: #fcfcfc;
        border-radius: 10px;
        padding: 10px 15px;
        font-weight: 600;
        color: var(--text-dark);
        transition: all 0.2s;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary-yellow);
            box-shadow: 0 0 0 3px rgba(255, 193, 7, 0.15);
            background-color: white;
        }

    /* --- Trip Card Design --- */
    .trip-card {
        border: none;
        border-radius: 20px;
        background: white;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: 0 5px 15px rgba(0,0,0,0.03);
        overflow: hidden;
        height: 100%;
        position: relative;
    }

        .trip-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        }

    .trip-img-wrapper {
        position: relative;
        overflow: hidden;
        height: 220px;
    }

        .trip-img-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s;
        }

    .trip-card:hover .trip-img-wrapper img {
        transform: scale(1.05);
    }

    /* תגיות צפות */
    .category-badge {
        position: absolute;
        top: 15px;
        left: 15px;
        background: rgba(0,0,0,0.7);
        backdrop-filter: blur(4px);
        color: white;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .card-body {
        padding: 20px;
        display: flex;
        flex-direction: column;
    }

    .location-text {
        color: var(--primary-orange);
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .trip-title {
        font-weight: 800;
        font-size: 1.25rem;
        margin-bottom: 10px;
        color: #2d3436;
        line-height: 1.3;
    }

    .trip-info-row {
        display: flex;
        align-items: center;
        gap: 15px;
        color: #636e72;
        font-size: 0.9rem;
        margin-bottom: 15px;
    }

        .trip-info-row i {
            color: var(--primary-yellow);
            margin-right: 5px;
        }

    .price-section {
        margin-top: auto;
        padding-top: 15px;
        border-top: 1px dashed #eee;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .price-tag {
        font-size: 1.4rem;
        font-weight: 800;
        color: #2d3436;
    }

        .price-tag small {
            font-size: 0.9rem;
            color: #b2bec3;
            font-weight: 400;
        }

    .discount-price {
        color: #e17055;
    }

    .btn-view {
        background: var(--bg-gray);
        color: var(--text-dark);
        border: none;
        width: 35px;
        height: 35px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s;
    }

    .trip-card:hover .btn-view {
        background: var(--primary-orange);
        color: white;
    }

    /* כפתור חיפוש */
    .btn-search {
        background: linear-gradient(45deg, var(--primary-orange), var(--primary-yellow));
        border: none;
        color: white;
        font-weight: bold;
        border-radius: 10px;
        transition: transform 0.2s;
    }

        .btn-search:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(255, 140, 0, 0.3);
            color: white;
        }

    /* כפתור איפוס */
    .btn-reset {
        border-color: #dee2e6;
        color: #6c757d;
        border-radius: 10px;
    }

        .btn-reset:hover {
            background-color: #e9ecef;
            color: #343a40;
        }

</style>

<div class="container-xxl mt-4">

    <div class="page-header">
        <h1>Find Your Next Adventure</h1>
        <p>Explore the best trips, hidden gems, and unforgettable experiences.</p>
    </div>

    <div class="search-container">
        <form method="get" action="@Url.Action("Index")" id="filterForm">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label"><i class="bi bi-search"></i> Search</label>
                    <input type="text" name="searchQuery" class="form-control" placeholder="Where to?" value="@Model.SearchQuery">
                </div>

                <div class="col-md-2">
                    <label class="form-label"><i class="bi bi-globe-americas"></i> Country</label>
                    <select name="country" class="form-select">
                        <option value="">Anywhere</option>
                        @foreach (var c in Model.AllCountries)
                        {
                            <option value="@c" selected="@(Model.SelectedCountry == c)">@c</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label"><i class="bi bi-tag"></i> Category</label>
                    <select name="category" class="form-select">
                        <option value="">All Types</option>
                        @foreach (var c in Model.AllCategories)
                        {
                            <option value="@c" selected="@(Model.SelectedCategory == c)">@c</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label"><i class="bi bi-sort-down"></i> Sort</label>
                    <select name="sortOrder" class="form-select">
                        <option value="date_asc" selected="@(Model.SortOrder == "date_asc")">Date: Sooner</option>
                        <option value="price_asc" selected="@(Model.SortOrder == "price_asc")">Price: Lowest</option>
                        <option value="price_desc" selected="@(Model.SortOrder == "price_desc")">Price: Highest</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-end">
                    <div class="d-flex w-100 gap-2">
                        <button type="submit" class="btn btn-search flex-grow-1 py-2">
                            <i class="bi bi-search me-2"></i> Find
                        </button>

                        <a href="@Url.Action("Index")" class="btn btn-reset py-2 d-flex align-items-center justify-content-center" title="Reset Filters" style="min-width: 50px;">
                            <i class="bi bi-arrow-counterclockwise fs-5"></i>
                        </a>
                    </div>
                </div>

                <div class="col-12 mt-3 pt-3 border-top">
                    <div class="row g-3 align-items-center">

                        <div class="col-auto">
                            <div class="form-check form-switch p-0 d-flex align-items-center gap-2">
                                <input class="form-check-input ms-0 mt-0" type="checkbox" name="onlyDiscounted" value="true" checked="@Model.OnlyDiscounted" id="discountSwitch">
                                <label class="form-check-label fw-bold small text-danger" for="discountSwitch">
                                    <i class="bi bi-percent"></i> Show Deals Only
                                </label>
                            </div>
                        </div>

                        <div class="col-auto ms-3 border-start ps-3 d-flex gap-2 align-items-center">
                            <label class="form-label mb-0 small fw-bold">Dates:</label>

                            <input type="date" id="startDate" name="startDate" class="form-control form-control-sm"
                                   min="@todayDate"
                                   value="@(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("yyyy-MM-dd") : "")">

                            <span class="text-muted">-</span>

                            <input type="date" id="endDate" name="endDate" class="form-control form-control-sm"
                                   min="@todayDate"
                                   value="@(Model.EndDate.HasValue ? Model.EndDate.Value.ToString("yyyy-MM-dd") : "")">
                        </div>

                        <div class="col-auto ms-auto d-flex gap-2 align-items-center">
                            <label class="form-label mb-0 small fw-bold">Price:</label>
                            <input type="number" name="minPrice" class="form-control form-control-sm" style="width: 80px;" placeholder="Min" value="@Model.MinPrice">
                            <span>-</span>
                            <input type="number" name="maxPrice" class="form-control form-control-sm" style="width: 80px;" placeholder="Max" value="@Model.MaxPrice">
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <div class="row">
        @if (Model.Trips.Count == 0)
        {
            <div class="col-12 text-center py-5">
                <div style="font-size: 4rem; color: #eee;"><i class="bi bi-airplane-engines"></i></div>
                <h3 class="text-muted mt-3">No trips found matching your criteria.</h3>
                <a href="@Url.Action("Index")" class="btn btn-outline-warning mt-2">Clear Filters</a>
            </div>
        }

        @foreach (var item in Model.Trips)
        {
            <div class="col-12 col-md-6 col-lg-3 mb-4 d-flex align-items-stretch">
                <div class="trip-card w-100">
                    <a href="/Trips/Details/@item.Id" class="stretched-link"></a>

                    <div class="trip-img-wrapper">
                        <img src="@item.MainImageUrl" alt="@item.Title">
                        <div class="category-badge">@item.Category</div>
                    </div>

                    <div class="card-body">
                        <div class="location-text">
                            <i class="bi bi-geo-alt-fill"></i> @item.Destination, @item.Country
                        </div>

                        <h5 class="trip-title">@item.Title</h5>

                        <div class="trip-info-row">
                            <span>
                                <i class="bi bi-calendar-event"></i>
                                @if (item.DisplayStartDate.HasValue && item.DisplayEndDate.HasValue)
                                {
                                    @item.DisplayStartDate.Value.ToString("MMM dd") <span class="mx-1">-</span> @item.DisplayEndDate.Value.ToString("MMM dd")
                                }
                                else if (item.DisplayStartDate.HasValue)
                                {
                                    @item.DisplayStartDate.Value.ToString("MMM dd, yyyy")
                                }
                            </span>

                            @if (item.DisplayAvailableRooms < 5)
                            {
                                <span class="text-danger fw-bold ms-auto" style="font-size: 0.8rem;">
                                    <i class="bi bi-fire text-danger"></i> Only @item.DisplayAvailableRooms left!
                                </span>
                            }
                        </div>

                        <div class="price-section">
                            <div>
                                @if (item.DisplayDiscountedPrice.HasValue)
                                {
                                    <div class="text-decoration-line-through text-muted small" style="font-size: 0.85rem;">$@item.DisplayPrice.ToString("N0")</div>
                                    <div class="price-tag discount-price">$@item.DisplayDiscountedPrice.Value.ToString("N0") <small>/person</small></div>
                                }
                                else
                                {
                                    <div class="price-tag">$@item.DisplayPrice.ToString("N0") <small>/person</small></div>
                                }
                            </div>

                            <div class="btn-view">
                                <i class="bi bi-arrow-right"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script>
    // --- 1. סקריפט לניקוי ה-URL (מונע שליחת שדות ריקים) ---
    document.getElementById('filterForm').addEventListener('submit', function(e) {
        // עוצר את השליחה הרגילה
        e.preventDefault();

        const url = new URL(this.action, window.location.origin);
        const formData = new FormData(this);

        for (const [key, value] of formData) {
            // הוסף ל-URL רק אם הערך לא ריק
            if (value && value.trim() !== "") {
                url.searchParams.append(key, value);
            }
        }

        // ניווט לכתובת הנקייה
        window.location.href = url.toString();
    });

    // --- 2. סקריפט לולידציית תאריכים ---
    const startDateInput = document.getElementById('startDate');
    const endDateInput = document.getElementById('endDate');

    // כאשר משנים את תאריך ההתחלה, עדכן את המינימום של תאריך הסיום
    startDateInput.addEventListener('change', function() {
        if(this.value) {
            endDateInput.min = this.value;
            // אם תאריך הסיום שנבחר קודם לכן הוא לפני ההתחלה החדשה - נקה אותו
            if(endDateInput.value && endDateInput.value < this.value) {
                endDateInput.value = "";
            }
        }
    });
</script>