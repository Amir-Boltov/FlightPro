@model FlightPro.Models.CheckoutViewModel

@{
    ViewData["Title"] = "Secure Checkout";
}

<style>
    body {
        background-color: #f8f9fa;
    }

    .checkout-container {
        max-width: 900px;
        margin: 50px auto;
    }

    /* Table Styling */
    .order-summary-card {
        background: white;
        border-radius: 16px;
        border: 1px solid #e9ecef;
        padding: 25px;
        margin-bottom: 30px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
    }

    .item-img {
        width: 70px;
        height: 70px;
        object-fit: cover;
        margin-right: 15px;
        border-radius: 10px;
    }

    /* Payment Option Card */
    .payment-option-card {
        border: 2px solid #e9ecef;
        border-radius: 16px;
        padding: 30px;
        text-align: center;
        background: white;
        transition: all 0.3s ease;
        height: 100%;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

        .payment-option-card:hover {
            border-color: #0d6efd;
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(13, 110, 253, 0.15);
        }

    .payment-icon {
        height: 60px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
    }

    .total-display-card {
        background: linear-gradient(135deg, #0d6efd, #0a58ca);
        color: white;
        border-radius: 16px;
        padding: 40px;
        text-align: center;
        box-shadow: 0 10px 30px rgba(13, 110, 253, 0.2);
        margin-bottom: 40px;
    }

    /* Stretched button to cover the whole card */
    .stretched-btn {
        background: none;
        border: none;
        width: 100%;
        padding: 0;
        text-align: inherit;
    }
</style>

<div class="container checkout-container">

    <div class="order-summary-card">
        <h4 class="mb-4 fw-bold text-dark border-bottom pb-2">Order Details</h4>
        <table class="table align-middle">
            <thead class="text-muted small text-uppercase">
                <tr>
                    <th>Trip</th>
                    <th>Dates</th>
                    <th>Qty</th>
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <img src="@item.Package.MainImageUrl"
                                     alt="@item.Package.Title"
                                     class="item-img shadow-sm">

                                <div>
                                    <span class="fw-bold d-block text-dark">@item.Package.Title</span>
                                    <small class="text-muted">ID: #@item.Id</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="small">
                                <i class="far fa-calendar-alt me-1 text-primary"></i>
                                @item.PackageDate.StartDate.ToString("MMM dd")
                                <span class="text-muted mx-1">-</span>
                                @item.PackageDate.EndDate.ToString("MMM dd")
                            </div>
                        </td>
                        <td class="fw-bold text-center">@item.Amount</td>
                        <td class="text-end fw-bold text-primary">@String.Format("{0:C}", item.TotalPrice)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="total-display-card">
        <h5 class="text-white-50 text-uppercase mb-2" style="letter-spacing: 1px;">Total Amount Due</h5>
        <h1 class="display-3 fw-bold mb-0">@String.Format("{0:C0}", Model.TotalAmount)</h1>
        <div class="mt-3 text-white-50">
            <i class="fas fa-shopping-bag me-1"></i> For @Model.ItemCount items
        </div>
    </div>

    <div class="text-center mb-4">
        <h3 class="fw-bold text-dark">Select Payment Method</h3>
        <p class="text-muted">Choose how you would like to pay securely</p>
    </div>

    <div class="row g-4 justify-content-center">

        <div class="col-md-5">
            <form asp-action="PayWithStripe" method="post" class="h-100">

                <input type="hidden" name="bookingId" value="@Model.DirectBookingId" />

                <button type="submit" class="stretched-btn h-100">
                    <div class="payment-option-card">
                        <div class="payment-icon text-primary">
                            <i class="fab fa-cc-visa fa-3x"></i>
                            <i class="fab fa-cc-mastercard fa-3x text-danger"></i>
                            <i class="fab fa-cc-amex fa-3x text-info"></i>
                        </div>
                        <h4 class="fw-bold mb-2">Credit Card</h4>
                        <p class="text-muted small mb-0">
                            Pay securely with Visa, Mastercard, or Amex via <strong>Stripe</strong> SSL encryption.
                        </p>
                        <div class="mt-4 btn btn-outline-primary rounded-pill px-4">
                            Pay with Card <i class="fas fa-arrow-right ms-2"></i>
                        </div>
                    </div>
                </button>
            </form>
        </div>

        <div class="col-md-5">
            <form asp-action="PayWithPayPal" method="post" class="h-100">

                <input type="hidden" name="bookingId" value="@Model.DirectBookingId" />

                <button type="submit" class="stretched-btn h-100">
                    <div class="payment-option-card">
                        <div class="payment-icon text-primary">
                            <i class="fab fa-paypal fa-4x text-primary"></i>
                        </div>
                        <h4 class="fw-bold mb-2">PayPal</h4>
                        <p class="text-muted small mb-0">
                            Login to your PayPal account to complete the purchase quickly and safely.
                        </p>
                        <div class="mt-4 btn btn-outline-primary rounded-pill px-4">
                            Pay with PayPal <i class="fas fa-arrow-right ms-2"></i>
                        </div>
                    </div>
                </button>
            </form>
        </div>

    </div>

    <div class="text-center mt-5">
        <div class="mb-3 text-muted small">
            <i class="fas fa-lock me-1"></i> Your payment is processed on secure servers. We do not store your financial details.
        </div>

        @if (Model.DirectBookingId.HasValue && Model.DirectBookingId.Value > 0)
        {
            <a href="/Trips/Index" class="text-decoration-none text-secondary">
                <i class="fas fa-arrow-left me-1"></i> Cancel and return to trips
            </a>
        }
        else
        {
            <a href="/MyBook/Index" class="text-decoration-none text-secondary">
                <i class="fas fa-arrow-left me-1"></i> Cancel and return to cart
            </a>
        }
    </div>

</div>