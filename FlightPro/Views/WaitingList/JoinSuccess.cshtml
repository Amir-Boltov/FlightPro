@{
    ViewData["Title"] = "You're on the list!";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">

            <div class="card border-0 shadow-lg rounded-4 p-5">
                <div class="mb-4">
                    <div style="width: 100px; height: 100px; background: #ecfdf5; color: #10b981; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 3rem; margin: 0 auto;">
                        <i class="bi bi-check-lg"></i>
                    </div>
                </div>

                <h2 class="fw-bold text-dark mb-3">You're on the Waiting List!</h2>

                <p class="text-muted mb-4" style="line-height: 1.6;">
                    We've received your request. If a spot opens up for your selected dates,
                    we will notify you immediately via email.
                </p>

                <div class="d-grid gap-3 col-8 mx-auto">
                    <a href="/Trips/Index" class="btn btn-primary btn-lg rounded-pill fw-bold">
                        Browse More Trips
                    </a>
                    <a href="/MyBook/Index" class="btn btn-outline-secondary rounded-pill fw-bold">
                        View My Bookings
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>