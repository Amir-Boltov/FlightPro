<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - FlightPro</title>
    <link rel="icon" type="image/jpeg" href="~/img/logo.jpg">
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;800&display=swap" rel="stylesheet">

    <style>
        /* הגדרות כלליות */
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f8f9fa;
        }

        /* --- עיצוב ה-Navbar --- */
        .navbar-custom {
            background: linear-gradient(135deg, #ffc107 0%, #ffca2c 100%);
            padding: 15px 0;
            transition: all 0.3s ease;
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }

        /* --- לוגו ואנימציית מטוס --- */
        .navbar-brand {
            font-weight: 800;
            font-size: 1.6rem;
            color: #212529 !important;
            position: relative;
            display: inline-block;
            padding-right: 20px;
            overflow: visible;
        }

        .brand-text {
            position: relative;
            z-index: 1;
        }

        .plane-icon {
            position: absolute;
            left: 0;
            bottom: 5px;
            font-size: 1.2rem;
            color: #212529;
            z-index: 2;
            transition: all 0.6s cubic-bezier(0.2, 1, 0.3, 1);
            transform: rotate(45deg);
        }

        /* האנימציה בהובר */
        .navbar-brand:hover .plane-icon {
            transform: translate(120px, -60px) rotate(-45deg) scale(0.5);
            opacity: 0;
        }

        /* לינקים בתפריט */
        .nav-link {
            font-weight: 600;
            color: #212529 !important;
            margin: 0 10px;
            position: relative;
            transition: color 0.3s;
        }

            /* אפקט קו תחתון נפתח */
            .nav-link::after {
                content: '';
                position: absolute;
                width: 0;
                height: 3px;
                bottom: 0;
                left: 50%;
                background-color: #000;
                transition: all 0.3s ease-in-out;
                transform: translateX(-50%);
                border-radius: 2px;
            }

            .nav-link:hover::after, .nav-link.active::after {
                width: 100%;
            }

        /* --- כפתורי משתמש (Avatar) --- */
        .user-avatar-badge {
            width: 40px;
            height: 40px;
            background-color: #212529;
            color: #ffc107;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 1.1rem;
            transition: transform 0.2s;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
            margin-left: 10px; /* ריווח מהטקסט */
        }

        .nav-item.dropdown:hover .user-avatar-badge {
            transform: scale(1.1);
        }

        /* עיצוב הטקסט של המשתמש */
        .user-hello-text {
            font-size: 0.8rem;
            opacity: 0.7;
            margin-bottom: -2px;
        }

        .user-name-text {
            font-weight: 800;
            font-size: 1.1rem;
            color: #212529;
        }

        /* תפריט נפתח */
        .dropdown-menu {
            border-radius: 15px;
            border: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            margin-top: 15px !important;
            overflow: hidden;
            animation: fadeIn 0.3s ease;
        }

        .dropdown-item {
            padding: 10px 20px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .dropdown-item i {
                font-size: 1.1rem;
                opacity: 0.7;
            }

            .dropdown-item:hover {
                background-color: #fff3cd;
                color: #000;
            }

                .dropdown-item:hover i {
                    opacity: 1;
                    transform: translateX(3px);
                    transition: transform 0.2s;
                }

        /* כפתורי התחברות/הרשמה */
        .btn-auth {
            border-radius: 50px;
            padding: 8px 25px;
            font-weight: 600;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .btn-login {
            background: transparent;
            border: 2px solid #212529;
            color: #212529;
        }

            .btn-login:hover {
                background: #212529;
                color: #fff;
            }

        .btn-register {
            background: #212529;
            border: 2px solid #212529;
            color: #ffc107;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }

            .btn-register:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(0,0,0,0.3);
                color: #fff;
            }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* פוטר */
        footer {
            background: #fff;
            box-shadow: 0 -5px 20px rgba(0,0,0,0.05);
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom shadow-sm sticky-top">
            <div class="container">
                <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                    <i class="bi bi-airplane-fill plane-icon"></i>
                    <span class="brand-text ps-4">FlightPro</span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Home")">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Trips")">Trips</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Reviews")">⭐ Reviews</a>
                        </li>

                        @{
                            var userRole = HttpContextAccessor.HttpContext.Session.GetString("UserRole");
                        }
                        @if (userRole == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-danger fw-bold" asp-area="" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-shield-lock"></i> Admin Panel
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        @using Microsoft.AspNetCore.Http
                        @inject IHttpContextAccessor HttpContextAccessor

                        @{
                            var userEmail = HttpContextAccessor.HttpContext.Session.GetString("UserEmail");
                            var userName = HttpContextAccessor.HttpContext.Session.GetString("UserName");
                            var initial = !string.IsNullOrEmpty(userName) ? userName.Substring(0, 1).ToUpper() : "?";
                        }

                        @if (!string.IsNullOrEmpty(userEmail))
                        {
                            <li class="nav-item me-2">
                                <a href="@Url.Action("Index","MyBook")" class="btn btn-light rounded-circle shadow-sm position-relative" style="width: 40px; height: 40px; display:flex; align-items:center; justify-content:center;">
                                    <i class="bi bi-bag-check-fill"></i>
                                </a>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 p-0" href="#" id="userDropdown" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">

                                    <div class="text-end d-none d-lg-block" style="line-height: 1.2;">
                                        <div class="user-hello-text">Hello,</div>
                                        <div class="user-name-text">@userName</div>
                                    </div>

                                    <div class="user-avatar-badge">
                                        @initial
                                    </div>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                                    <li><h6 class="dropdown-header">My Account</h6></li>
                                    <li><a class="dropdown-item" href="@Url.Action("OrderHistory","MyBook")"><i class="bi bi-ticket-perforated"></i> Bookings</a></li>
                                    <li><a class="dropdown-item" href="@Url.Action("Index","MyBook")"><i class="bi bi-cart"></i> My Cart</a></li>
                                    <li><a class="dropdown-item" href="@Url.Action("Index","WaitingList")"><i class="bi bi-hourglass-split"></i> Waiting Lists</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger fw-bold" href="@Url.Action("Logout", "User")">
                                            <i class="bi bi-box-arrow-right"></i> Logout
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-auth btn-login" href="@Url.Action("ViewLogin", "User")">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-auth btn-register" href="@Url.Action("ViewRegister", "User")">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4" style="min-height: 80vh;">
        @RenderBody()
    </div>

    <footer class="text-center py-4 mt-5">
        <div class="container">
            <p class="mb-0 text-muted">&copy; 2025 FlightPro. Fly safe, fly high.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>