@model FlightPro.Models.ReviewsPageViewModel

@{
    ViewData["Title"] = "My Reviews";
    // We cast the ViewBag to a list so we can check the count safely
    var packageList = ViewBag.Packages as List<SelectListItem>;
}

<style>
    .review-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border: none;
    }

        .review-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }

    .avatar-circle {
        width: 45px;
        height: 45px;
        font-weight: bold;
        font-size: 1.1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }
</style>

<div class="container mt-5 mb-5">

    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">My Review History</h1>
        <p class="lead text-muted">Manage the feedback you've shared with the community.</p>
        <hr class="w-25 mx-auto text-warning opacity-100" style="height: 3px;">
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success rounded-pill text-center shadow-sm">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
        </div>
    }

    <div class="row g-4">

        <div class="col-lg-6">
            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
                <h3 class="fw-bold"><i class="bi bi-laptop me-2"></i>Site Reviews</h3>

                <button type="button" class="btn btn-outline-dark rounded-pill btn-sm fw-bold" data-bs-toggle="modal" data-bs-target="#siteReviewModal">
                    <i class="bi bi-plus-lg"></i> Write Review
                </button>
            </div>

            @if (Model.GeneralReviews.Count == 0)
            {
                <div class="text-center py-5 text-muted border rounded bg-light">
                    <i class="bi bi-chat-square-dots fs-1 mb-2"></i>
                    <p>You haven't reviewed the website yet.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var review in Model.GeneralReviews)
                    {
                        <div class="card review-card shadow-sm" style="background-color: #fffbe6;">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="me-auto">
                                        <h6 class="mb-0 fw-bold">My Feedback</h6>
                                        <small class="text-muted" style="font-size: 0.8rem;">@review.Date.ToString("MMM dd, yyyy")</small>
                                    </div>
                                    <div class="text-warning small">
                                        @for (int i = 0; i < review.Rating; i++)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        @for (int i = review.Rating; i < 5; i++)
                                        {
                                            <i class="bi bi-star"></i>
                                        }
                                    </div>
                                </div>
                                <p class="card-text text-dark fst-italic mb-0 ps-1 border-start border-3 border-warning">
                                    &nbsp;"@review.Comment"
                                </p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="col-lg-6">
            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
                <h3 class="fw-bold"><i class="bi bi-airplane me-2"></i>Trip Reviews</h3>

                <button type="button" class="btn btn-warning rounded-pill btn-sm fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#packageReviewModal">
                    <i class="bi bi-star-fill me-1"></i> Rate a Trip
                </button>
            </div>

            @if (Model.PackageReviews.Count == 0)
            {
                <div class="text-center py-5 text-muted border rounded bg-light">
                    <i class="bi bi-geo-alt fs-1 mb-2"></i>
                    <p>You haven't reviewed any trips yet.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var review in Model.PackageReviews)
                    {
                        <div class="card review-card shadow-sm border">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="badge bg-dark text-warning">
                                        <i class="bi bi-pin-map-fill me-1"></i> @review.PackageTitle
                                    </span>
                                    <small class="text-muted">@review.Date.ToString("MMM dd, yyyy")</small>
                                </div>

                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-bold small">My Rating:</span>
                                    <div class="text-warning small">
                                        @for (int i = 0; i < review.Rating; i++)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                    </div>
                                </div>
                                <hr class="my-2" />
                                <p class="card-text text-muted mb-0">
                                    "@review.Comment"
                                </p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="siteReviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Review Our Website</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Reviews" asp-action="AddSiteReview" method="post">
                <div class="modal-body">
                    <div class="form-floating mb-3">
                        <select class="form-select" name="rating" id="ratingSite" required>
                            <option value="5" selected>⭐⭐⭐⭐⭐ - Amazing</option>
                            <option value="4">⭐⭐⭐⭐ - Good</option>
                            <option value="3">⭐⭐⭐ - Okay</option>
                            <option value="2">⭐⭐ - Bad</option>
                            <option value="1">⭐ - Terrible</option>
                        </select>
                        <label for="ratingSite">Rating</label>
                    </div>
                    <div class="form-floating">
                        <textarea class="form-control" name="comment" id="commentSite" style="height: 100px" required placeholder="Comment"></textarea>
                        <label for="commentSite">Your experience...</label>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-link text-muted text-decoration-none" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark px-4 rounded-pill">Submit</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="packageReviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Rate Your Trip</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            @if (packageList != null && packageList.Count > 0)
            {
                <form asp-controller="Reviews" asp-action="AddPackageReview" method="post">
                    <div class="modal-body">
                        <div class="form-floating mb-3">
                            <select class="form-select" name="packageId" id="packId" required>
                                <option value="" disabled selected>Select trip...</option>
                                @foreach (var item in packageList)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                            <label for="packId">Destination</label>
                        </div>
                        <div class="form-floating mb-3">
                            <select class="form-select" name="rating" id="ratingPack" required>
                                <option value="5">⭐⭐⭐⭐⭐</option>
                                <option value="4">⭐⭐⭐⭐</option>
                                <option value="3">⭐⭐⭐</option>
                                <option value="2">⭐⭐</option>
                                <option value="1">⭐</option>
                            </select>
                            <label for="ratingPack">Rating</label>
                        </div>
                        <div class="form-floating">
                            <textarea class="form-control" name="comment" id="commentPack" style="height: 100px" required placeholder="Comment"></textarea>
                            <label for="commentPack">How was it?</label>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-link text-muted text-decoration-none" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-warning px-4 rounded-pill fw-bold">Submit</button>
                    </div>
                </form>
            }
            else
            {
                <div class="modal-body text-center p-4">
                    <p class="text-muted">You have no completed trips to review yet.</p>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Close</button>
                </div>
            }
        </div>
    </div>
</div>