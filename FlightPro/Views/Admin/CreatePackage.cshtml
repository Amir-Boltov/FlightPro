@model FlightPro.Models.PackageModel
@{
    ViewData["Title"] = "Package Creation";
}

<div class="container mt-4" style="max-width: 800px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Create New Package</h2>
        <a asp-action="Packages" class="btn btn-secondary">Cancel</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="CreatePackage" method="post">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger"></div>
                }

                <h5 class="text-black mb-3">1. Basic Information</h5>

                <div class="row">
                    <div class="col-md-8 mb-3">
                        <label class="form-label fw-bold">Package Title <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" placeholder="e.g., Weekend in Paris" required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Destination <span class="text-danger">*</span></label>
                        <select name="DestinationId" class="form-select" required>
                            <option value="">-- Select City --</option>
                            @if (ViewBag.Destinations != null)
                            {
                                @foreach (var dest in (List<SelectListItem>)ViewBag.Destinations)
                                {
                                    <option value="@dest.Value">@dest.Text</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label fw-bold">Category <span class="text-danger">*</span></label>
                        <select asp-for="Category" class="form-select" required>
                            <option>Adventure</option>
                            <option>Relaxation</option>
                            <option>History</option>
                            <option>Family</option>
                            <option>Urban</option>
                        </select>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label fw-bold">Age Limit <span class="text-danger">*</span></label>
                        <input asp-for="MinAge" class="form-control" required type="number" min="0" value="0" />
                        <div class="form-text">0 for no limit</div>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label fw-bold">Cancel Days <span class="text-danger">*</span></label>
                        <input asp-for="CancellationDeadlineDays" class="form-control" required type="number" min="0" value="7" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label asp-for="ExpiryMinutes" class="form-label fw-bold">Cart/WL Hold <span class="text-danger">*</span></label>
                        <input asp-for="ExpiryMinutes" class="form-control" required type="number" min="1" value="15" />
                        <span asp-validation-for="ExpiryMinutes" class="text-danger small"></span>
                        <div class="form-text">Minutes (Default: 15)</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Description <span class="text-danger">*</span></label>
                    <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <hr class="my-4" />

                <h5 class="text-black mb-3">2. Images</h5>

                <div class="mb-3">
                    <label class="form-label fw-bold">Main Image URL <span class="text-danger">*</span></label>
                    <input asp-for="MainImageUrl" class="form-control" placeholder="https://..." required />
                    <span asp-validation-for="MainImageUrl" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label small">Extra Image 1 (Optional)</label>
                        <input asp-for="ImageUrl2" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label small">Extra Image 2 (Optional)</label>
                        <input asp-for="ImageUrl3" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label small">Extra Image 3 (Optional)</label>
                        <input asp-for="ImageUrl4" class="form-control form-control-sm" />
                    </div>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-success btn-lg">Create Package & Continue</button>
                </div>

            </form>
        </div>
    </div>
</div>