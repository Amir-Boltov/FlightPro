@model FlightPro.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Panel";
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    /* עיצובים מותאמים אישית לאדמין */
    .sidebar {
        min-height: 100vh;
        box-shadow: 2px 0 5px rgba(0,0,0,0.05);
        background-color: #fff;
    }

    .nav-link {
        color: #333;
        font-weight: 500;
        padding: 10px 15px;
        border-radius: 8px;
        transition: all 0.3s;
    }

        .nav-link:hover, .nav-link.active {
            background-color: #e9ecef;
            color: #0d6efd;
        }

        .nav-link.active {
            font-weight: 700;
        }

        .nav-link i {
            margin-right: 10px;
            font-size: 1.1rem;
        }

    .stat-card {
        border: none;
        border-radius: 15px;
        transition: transform 0.2s;
        overflow: hidden;
        background: #fff;
    }

        .stat-card:hover {
            transform: translateY(-5px);
        }

    .stat-icon {
        font-size: 2.5rem;
        opacity: 0.3;
    }

    .table-custom th {
        background-color: #f8f9fa;
        font-weight: 600;
        color: #6c757d;
        border-top: none;
    }

    .table-custom tr {
        vertical-align: middle;
    }

    .table-custom td {
        padding-top: 15px;
        padding-bottom: 15px;
    }
</style>

<div class="container-fluid" style="background-color: #f8f9fa;">
    <div class="row">
        <nav class="col-md-3 col-lg-2 d-md-block sidebar collapse show">
            <div class="position-sticky pt-3">
                <div class="text-center mb-4">
                    <h5 class="fw-bold text-primary"><i class="bi bi-airplane-engines me-2"></i>FlightPro</h5>
                </div>
                <ul class="nav flex-column">
                    <li class="nav-item mb-2">
                        <a class="nav-link active" asp-action="Index" asp-controller="Admin">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item mb-2">
                        <a class="nav-link" asp-action="Packages">
                            <i class="bi bi-box-seam"></i> Manage Packages
                        </a>
                    </li>
                    <li class="nav-item mb-2">
                        <a class="nav-link" asp-action="Users">
                            <i class="bi bi-people"></i> Manage Users
                        </a>
                    </li>
                    <li class="nav-item mb-2">
                        <a class="nav-link" asp-action="Waitlists">
                            <i class="bi bi-list-check"></i> Waiting Lists
                        </a>
                    </li>
                </ul>
            </div>
        </nav>

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 min-vh-100">

            <div class="card border-0 shadow-sm mb-4 mt-4 rounded-3 overflow-hidden">
                <div class="card-body p-3 d-flex align-items-center justify-content-between text-white"
                     style="background: linear-gradient(90deg, #1e3c72 0%, #2a5298 100%);">
                    <div>
                        <h4 class="mb-0 fw-bold"><i class="bi bi-speedometer2 me-2"></i>Dashboard</h4>
                        <small class="opacity-75">Overview & Statistics</small>
                    </div>
                    <div class="d-none d-md-block">
                        <span class="badge bg-white bg-opacity-10 border border-white border-opacity-25 p-2 fw-normal">
                            <i class="bi bi-calendar-event me-2"></i> @DateTime.Now.ToString("dd MMM yyyy")
                        </span>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-md-3">
                    <div class="card stat-card shadow-sm h-100 border-start border-4 border-primary">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.8rem;">Total Bookings</h6>
                                <h2 class="mb-0 fw-bold">@Model.TotalBookings</h2>
                            </div>
                            <div class="stat-icon text-primary">
                                <i class="bi bi-ticket-perforated-fill"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card stat-card shadow-sm h-100 border-start border-4 border-success">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.8rem;">Total Revenue</h6>
                                <h2 class="mb-0 fw-bold text-success">@Model.TotalRevenue.ToString("C0")</h2>
                            </div>
                            <div class="stat-icon text-success">
                                <i class="bi bi-currency-dollar"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card stat-card shadow-sm h-100 border-start border-4 border-warning">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.8rem;">Active Packages</h6>
                                <h2 class="mb-0 fw-bold">@Model.ActivePackages</h2>
                            </div>
                            <div class="stat-icon text-warning">
                                <i class="bi bi-airplane-fill"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card stat-card shadow-sm h-100 border-start border-4 border-info">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.8rem;">Registered Users</h6>
                                <h2 class="mb-0 fw-bold">@Model.UsersCount</h2>
                            </div>
                            <div class="stat-icon text-info">
                                <i class="bi bi-people-fill"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-12">
                    <div class="card shadow-sm border-0 rounded-3">
                        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-bar-chart-fill me-2"></i>Top Selling Packages</h5>
                        </div>
                        <div class="card-body">
                            <div style="height: 350px;">
                                <canvas id="packagesChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 rounded-3 mb-5">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">Recent Bookings</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-custom mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">#ID</th>
                                    <th>Date</th>
                                    <th>Customer</th>
                                    <th>Package</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.RecentBookings)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold">#@item.Id</td>
                                        <td>
                                            @item.CreatedAt.ToString("MMM dd, yyyy")
                                            <br>
                                            <small class="text-muted">@item.CreatedAt.ToString("HH:mm")</small>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-2 text-center text-primary" style="width:35px; height:35px; display:flex; align-items:center; justify-content:center;">
                                                    <span class="fw-bold">@item.CustFirstName.Substring(0, 1)</span>
                                                </div>
                                                @item.CustFirstName @item.CustLastName
                                            </div>
                                        </td>
                                        <td><span class="fw-bold text-dark">@item.PackageTitle</span></td>
                                        <td>@item.PricePaid.ToString("C0")</td>
                                        <td>
                                            @if (item.Status == "Canceled")
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill">Canceled</span>
                                            }
                                            else if (item.Status == "InCart")
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill">Pending</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">Confirmed</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </main>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        var ctx = document.getElementById('packagesChart').getContext('2d');

        // קבלת נתונים אמיתיים מהשרת
        var dbLabels = @Html.Raw(Json.Serialize(Model.ChartLabels));
        var dbData = @Html.Raw(Json.Serialize(Model.ChartData));

        var myChart = new Chart(ctx, {
            type: 'bar', // שיניתי ל-Bar כי זה מתאים יותר להשוואת חבילות
            data: {
                labels: dbLabels,
                datasets: [{
                    label: 'Bookings Count',
                    data: dbData,
                    backgroundColor: [
                        'rgba(54, 162, 235, 0.7)',
                        'rgba(255, 99, 132, 0.7)',
                        'rgba(255, 206, 86, 0.7)',
                        'rgba(75, 192, 192, 0.7)',
                        'rgba(153, 102, 255, 0.7)'
                    ],
                    borderColor: [
                        'rgba(54, 162, 235, 1)',
                        'rgba(255, 99, 132, 1)',
                        'rgba(255, 206, 86, 1)',
                        'rgba(75, 192, 192, 1)',
                        'rgba(153, 102, 255, 1)'
                    ],
                    borderWidth: 1,
                    borderRadius: 5,
                    barPercentage: 0.6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false // הסתרת המקרא כי הכותרת מספיקה
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.parsed.y + ' Bookings';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: {
                            borderDash: [5, 5],
                            drawBorder: false
                        },
                        ticks: {
                            precision: 0 // מציג רק מספרים שלמים
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        }
                    }
                }
            }
        });
    });
</script>