@model List<FlightPro.Models.DestinationModel>
@{
    ViewData["Title"] = "Manage Destinations";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Manage Destinations</h2>
        <a asp-action="CreateDestination" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add New
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Country</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dest in Model)
                    {
                        <tr>
                            <td>@dest.Id</td>
                            <td class="fw-bold">@dest.Name</td>
                            <td>@dest.Country</td>
                            <td class="text-end">
                                <form asp-action="DeleteDestination" method="post" class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete @dest.Name?');">

                                    <input type="hidden" name="id" value="@dest.Id" />

                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>