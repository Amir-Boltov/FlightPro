@model FlightPro.Models.PackageModel

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Edit Package: @Model.Title</h2>
        <a asp-action="Packages" class="btn btn-secondary">Back to List</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row">
        <div class="col-md-7">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Package Information</h5>
                </div>
                <div class="card-body">
                    <form asp-action="EditPackage" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Package Title</label>
                            <input asp-for="Title" class="form-control" required />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Category</label>
                                <select asp-for="Category" class="form-select">
                                    <option>Adventure</option>
                                    <option>Relaxation</option>
                                    <option>History</option>
                                    <option>Family</option>
                                </select>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Age Limit</label>
                                <input asp-for="MinAge" class="form-control" type="number" min="0" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Cancel Days</label>
                                <input asp-for="CancellationDeadlineDays" class="form-control" type="number" min="0" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>

                        <hr />

                        <h6 class="text-primary mb-3">Image URLs (Max 4)</h6>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Main Image URL (Required)</label>
                            <input asp-for="MainImageUrl" class="form-control" placeholder="https://example.com/main.jpg" required />
                            <div class="form-text small">This image will appear on search cards.</div>
                        </div>

                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label small">Extra Image 1</label>
                                <input asp-for="ImageUrl2" class="form-control form-control-sm" placeholder="https://..." />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small">Extra Image 2</label>
                                <input asp-for="ImageUrl3" class="form-control form-control-sm" placeholder="https://..." />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small">Extra Image 3</label>
                                <input asp-for="ImageUrl4" class="form-control form-control-sm" placeholder="https://..." />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary mt-4 w-100">
                            <i class="bi bi-save"></i> Save Changes
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card border-warning shadow-sm">
                <div class="card-header bg-warning-subtle d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-dark">Travel Dates</h5>
                    <a asp-action="AddPackageDate" asp-route-packageId="@Model.Id" class="btn btn-sm btn-success">
                        <i class="bi bi-plus-lg"></i> Add Date
                    </a>
                </div>

                <div class="card-body p-0">
                    @if (Model.AvailableSchedules.Count == 0)
                    {
                        <div class="p-4 text-center text-muted">
                            No dates added yet. Click "Add Date" to create one.
                        </div>
                    }
                    else
                    {
                        <table class="table table-hover mb-0" style="font-size: 0.9rem;">
                            <thead class="table-light">
                                <tr>
                                    <th>Date Range</th>
                                    <th>Price</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var date in Model.AvailableSchedules)
                                {
                                    <tr>
                                        <td class="align-middle">
                                            <div class="fw-bold">@date.StartDate.ToString("MMM dd, yyyy")</div>
                                            <small class="text-muted">to @date.EndDate.ToString("MMM dd, yyyy")</small>
                                        </td>
                                        <td class="align-middle">
                                            @if (date.DiscountedPrice.HasValue)
                                            {
                                                <span class="text-danger fw-bold">$@date.DiscountedPrice</span>

                                                <br>
                                                <span class="text-decoration-line-through text-muted small">$@date.Price</span>
                                            }
                                            else
                                            {
                                                <span>$@date.Price.ToString("N0")</span>
                                            }
                                        </td>
                                        <td class="align-middle text-end">
                                            <a asp-action="EditSchedule" asp-route-id="@date.Id" class="btn btn-sm btn-outline-dark mb-1">
                                                <i class="bi bi-pencil"></i> Edit Date
                                            </a>

                                            <form asp-action="DeleteSchedule" method="post" class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this date? This only works if NO ONE has booked it.');">
                                                <input type="hidden" name="dateId" value="@date.Id" />
                                                <input type="hidden" name="packageId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-sm btn-danger mb-1">
                                                    <i class="bi bi-trash"></i> Delete Date
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>