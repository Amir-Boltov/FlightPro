@model FlightPro.Models.AdminReviewsViewModel
@{
    ViewData["Title"] = "Manage Reviews";
}

<style>
    /* --- General Admin Styles --- */
    body {
        background-color: #f8f9fa;
    }

    .sidebar {
        min-height: 100vh;
        background: #fff;
        box-shadow: 2px 0 5px rgba(0,0,0,0.05);
    }

    .nav-link {
        color: #333;
        font-weight: 500;
        padding: 10px 15px;
        border-radius: 8px;
        transition: 0.3s;
    }

        .nav-link:hover {
            background-color: #f8f9fa;
            color: #0d6efd;
        }

        .nav-link.active {
            background-color: #e9ecef;
            color: #0d6efd;
            font-weight: 700;
        }

        .nav-link i {
            margin-right: 10px;
            font-size: 1.1rem;
        }

    /* Tabs Customization */
    .nav-tabs .nav-link {
        border: none;
        color: #6c757d;
        font-weight: 600;
        padding: 10px 20px;
        border-radius: 30px;
        margin-right: 10px;
        background-color: #e9ecef;
    }

        .nav-tabs .nav-link.active {    
            background-color: #fcb603;
            color: white;
        }

    /* Table Styles */
    .table-container {
        background: white;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        overflow: hidden;
        margin-top: 20px;
    }

    .table thead th {
        background-color: #212529;
        color: #fff;
        border: none;
        font-weight: 600;
        padding: 15px;
    }

    .table tbody td {
        padding: 15px;
        vertical-align: middle;
        border-bottom: 1px solid #f0f0f0;
    }

    .text-warning {
        color: #ffc107 !important;
    }

    .btn-delete {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        background-color: #ffe5e5;
        color: #dc3545;
        transition: 0.2s;
    }

        .btn-delete:hover {
            background-color: #dc3545;
            color: white;
            transform: translateY(-2px);
        }
</style>

<div class="container-fluid">
    <div class="row">

        <nav class="col-md-3 col-lg-2 d-md-block sidebar collapse show">
            <div class="position-sticky pt-3">
                <div class="text-center mb-4"><h5 class="fw-bold">Admin Panel</h5></div>
                <ul class="nav flex-column">
                    <li class="nav-item mb-2"><a class="nav-link" asp-action="Index" asp-controller="Admin"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                    <li class="nav-item mb-2"><a class="nav-link" asp-action="Packages"><i class="bi bi-box-seam"></i> Manage Packages</a></li>
                    <li class="nav-item mb-2"><a class="nav-link" asp-action="Users"><i class="bi bi-people"></i> Manage Users</a></li>
                    <li class="nav-item mb-2"><a class="nav-link" asp-action="Waitlists"><i class="bi bi-list-check"></i> Waiting Lists</a></li>
                    <li class="nav-item mb-2"><a class="nav-link" asp-action="Destinations"><i class="bi bi-map"></i> Manage Destinations</a></li>
                    <li class="nav-item mb-2"><a class="nav-link active" asp-action="Reviews"><i class="bi bi-star-half"></i> Reviews</a></li>
                </ul>
            </div>
        </nav>

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 bg-light min-vh-100">
            <div class="pt-4 pb-2 mb-4 border-bottom d-flex justify-content-between align-items-center">
                <h2 class="h2">Manage Reviews</h2>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <ul class="nav nav-tabs" id="reviewTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="site-tab" data-bs-toggle="tab" data-bs-target="#site-reviews" type="button">Site Reviews</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="pkg-tab" data-bs-toggle="tab" data-bs-target="#pkg-reviews" type="button">Package Reviews</button>
                </li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="site-reviews">
                    <div class="table-container">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th class="ps-4">User</th>
                                        <th>Rating</th>
                                        <th style="width: 40%;">Comment</th>
                                        <th>Date</th>
                                        <th class="text-end pe-4">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.SiteReviews != null && Model.SiteReviews.Any())
                                    {
                                        @foreach (var r in Model.SiteReviews)
                                        {
                                            <tr>
                                                <td class="ps-4 fw-bold">@r.UserName</td>
                                                <td>
                                                    <div class="text-warning small">
                                                        @for (int i = 0; i < r.Rating; i++)
                                                        {
                                                            <i class="bi bi-star-fill"></i>
                                                        }
                                                    </div>
                                                </td>
                                                <td class="text-muted text-wrap">"@r.Comment"</td>
                                                <td>@r.Date.ToString("MMM dd, yyyy")</td>
                                                <td class="text-end pe-4">
                                                    <form asp-action="DeleteSiteReview" method="post" onsubmit="return confirm('Delete this review?');">
                                                        <input type="hidden" name="id" value="@r.Id" />
                                                        <button type="submit" class="btn-delete"><i class="bi bi-trash"></i></button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr><td colspan="5" class="text-center py-5 text-muted">No site reviews found.</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="pkg-reviews">
                    <div class="table-container">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th class="ps-4">Package</th>
                                        <th>User</th>
                                        <th>Rating</th>
                                        <th style="width: 35%;">Comment</th>
                                        <th>Date</th>
                                        <th class="text-end pe-4">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.PackageReviews != null && Model.PackageReviews.Any())
                                    {
                                        @foreach (var r in Model.PackageReviews)
                                        {
                                            <tr>
                                                <td class="ps-4 fw-bold text-primary">@r.PackageTitle</td>
                                                <td class="fw-bold">@r.UserName</td>
                                                <td>
                                                    <div class="text-warning small">
                                                        @for (int i = 0; i < r.Rating; i++)
                                                        {
                                                            <i class="bi bi-star-fill"></i>
                                                        }
                                                    </div>
                                                </td>
                                                <td class="text-muted text-wrap">"@r.Comment"</td>
                                                <td>@r.Date.ToString("MMM dd, yyyy")</td>
                                                <td class="text-end pe-4">
                                                    <form asp-action="DeletePackageReview" method="post" onsubmit="return confirm('Delete this review?');">
                                                        <input type="hidden" name="id" value="@r.Id" />
                                                        <button type="submit" class="btn-delete"><i class="bi bi-trash"></i></button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr><td colspan="6" class="text-center py-5 text-muted">No package reviews found.</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>