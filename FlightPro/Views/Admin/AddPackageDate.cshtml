@{
    ViewData["Title"] = "Add Travel Date";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0"><i class="bi bi-calendar-plus"></i> Add New Schedule</h4>
                </div>
                <div class="card-body">
                    <form asp-action="AddPackageDate" method="post">
                        <input type="hidden" name="packageId" value="@ViewBag.PackageId" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Start Date</label>
                            <input type="date" name="startDate" id="startDate"
                                   class="form-control"
                                   min="@DateTime.Now.ToString("yyyy-MM-dd")"
                                   onchange="updateDates()"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">End Date</label>
                            <input type="date" name="endDate" id="endDate"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-danger">Last Day to Book</label>
                            <input type="date" name="bookingEndDate" id="bookingEndDate"
                                   class="form-control"
                                   required />
                            <div class="form-text">
                                Bookings will close on this date. (Must be before the trip starts).
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Price per Person ($)</label>
                                <input type="number" name="price" class="form-control" min="0" step="0.01" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Total Rooms</label>
                                <input type="number" name="totalRooms" class="form-control" min="1" value="20" required />
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success">Save Schedule</button>
                            <a asp-action="Packages" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function updateDates() {
        var startInput = document.getElementById('startDate');
        var endInput = document.getElementById('endDate');
        var bookingInput = document.getElementById('bookingEndDate');

        var startDateVal = startInput.value;

        if (startDateVal) {
            // Rule A: Trip End Date cannot be before Start Date
            endInput.min = startDateVal;
            if (endInput.value && endInput.value < startDateVal) {
                endInput.value = startDateVal;
            }

            // Rule B: Booking Deadline cannot be AFTER the Trip Start Date
            // (You can't book a trip that has already left)
            bookingInput.max = startDateVal;

            // Also ensure Booking Deadline isn't in the past (today is min)
            var today = new Date().toISOString().split('T')[0];
            bookingInput.min = today;

            if (bookingInput.value && bookingInput.value > startDateVal) {
                bookingInput.value = startDateVal;
            }
        }
    }
</script>