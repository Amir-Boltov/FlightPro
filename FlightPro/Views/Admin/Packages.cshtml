@model List<FlightPro.Models.PackageModel>
@{
    ViewData["Title"] = "Package Managment";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage Travel Packages</h2>
        <a asp-action="CreatePackage" class="btn btn-warning">
            <i class="bi bi-plus-circle"></i> Add New Package
        </a>
    </div>

    <table class="table table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Destination</th>
                <th>Category</th>
                <th>Age Limit</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Title</td>
                    <td>@item.Destination, @item.Country</td>
                    <td>@item.Category</td>
                    <td>@(item.MinAge > 0 ? item.MinAge + "+" : "None")</td>
                    <td>
                        <a asp-action="AddPackageDate" asp-route-packageId="@item.Id" class="btn btn-sm btn-success me-1">
                            <i class="bi bi-calendar-plus"></i> Add Date
                        </a>
                        <a asp-action="EditPackage" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark">
                            <i class="bi bi-pencil"></i> Edit
                        </a>

                        <form asp-action="DeletePackage" asp-route-id="@item.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Are you sure? This cannot be undone.');">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>