@model List<FlightPro.Models.AdminWaitlistViewModel>

@{
    ViewData["Title"] = "Manage Waitlists";
}

<style>
    /* --- General Admin Styles (Matches Users.cshtml) --- */
    body {
        background-color: #f8f9fa;
    }

    .sidebar {
        min-height: 100vh;
        box-shadow: 2px 0 5px rgba(0,0,0,0.05);
        background: #fff;
    }

    .nav-link {
        color: #333;
        font-weight: 500;
        padding: 10px 15px;
        border-radius: 8px;
        transition: all 0.3s;
    }

        .nav-link:hover {
            background-color: #f8f9fa;
            color: #0d6efd;
        }

        .nav-link.active {
            background-color: #e9ecef;
            color: #0d6efd;
            font-weight: 700;
        }

        .nav-link i {
            margin-right: 10px;
            font-size: 1.1rem;
        }

    /* Accordion Customization */
    .accordion-button:not(.collapsed) {
        background-color: #e7f1ff;
        color: #0c63e4;
        box-shadow: none;
    }

    .accordion-button:focus {
        box-shadow: none;
        border-color: rgba(0,0,0,.125);
    }

    /* Table Styling inside Accordion */
    .table thead th {
        background-color: #f8f9fa;
        color: #495057;
        font-weight: 600;
        border-bottom: 2px solid #e9ecef;
    }

    .avatar-circle-sm {
        width: 25px;
        height: 25px;
        background-color: #212529;
        color: white;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
    }
</style>

<div class="container-fluid">
    <div class="row">

        <nav class="col-md-3 col-lg-2 d-md-block sidebar collapse show">
            <div class="position-sticky pt-3">
                <div class="text-center mb-4">
                    <h5 class="fw-bold">Admin Panel</h5>
                </div>
                <ul class="nav flex-column">
                    <li class="nav-item mb-2">
                        <a class="nav-link" asp-action="Index" asp-controller="Admin">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item mb-2">
                        <a class="nav-link" asp-action="Packages">
                            <i class="bi bi-box-seam"></i> Manage Packages
                        </a>
                    </li>
                    <li class="nav-item mb-2">
                        <a class="nav-link" asp-action="Users">
                            <i class="bi bi-people"></i> Manage Users
                        </a>
                    </li>
                    <li class="nav-item mb-2">
                        <a class="nav-link active" asp-action="Waitlists">
                            <i class="bi bi-list-check"></i> Waiting Lists
                        </a>
                    </li>
                    <li class="nav-item mb-2">
                        <a class="nav-link" asp-action="Destinations">
                            <i class="bi bi-map"></i> Manage Destinations
                        </a>
                    </li>
                    <li class="nav-item mb-2">
                        <a class="nav-link" asp-action="Reviews">
                            <i class="bi bi-star-half"></i> View/Manage Reviews
                        </a>
                    </li>
                </ul>
            </div>
        </nav>

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 bg-light min-vh-100">

            <div class="pt-4 pb-2 mb-4 border-bottom d-flex justify-content-between align-items-center">
                <h2 class="h2">Manage Waiting Lists</h2>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5 text-muted bg-white border rounded-3 shadow-sm">
                    <i class="bi bi-clipboard-check display-4 mb-3 d-block text-secondary"></i>
                    <h5 class="fw-bold">No Active Waitlists</h5>
                    <p class="mb-0">Currently, no users are waiting for any fully booked trips.</p>
                </div>
            }
            else
            {
                <div class="accordion" id="waitlistAccordion">
                    @foreach (var group in Model)
                    {
                        <div class="accordion-item shadow-sm mb-3 border-0 rounded overflow-hidden">
                            <h2 class="accordion-header" id="heading-@group.PackageDateId">
                                <button class="accordion-button collapsed bg-white py-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@group.PackageDateId" aria-expanded="false">
                                    <div class="d-flex w-100 justify-content-between align-items-center me-3">
                                        <div>
                                            <i class="bi bi-geo-alt-fill text-danger me-2"></i>
                                            <span class="fw-bold text-dark me-2" style="font-size: 1.05rem;">@group.PackageTitle</span>
                                            <span class="badge bg-light text-dark border fw-normal">
                                                @group.StartDate.ToString("MMM dd") - @group.EndDate.ToString("MMM dd")
                                            </span>
                                        </div>
                                        <span class="badge bg-secondary rounded-pill">@group.Entries.Count Waiting</span>
                                    </div>
                                </button>
                            </h2>
                            <div id="collapse-@group.PackageDateId" class="accordion-collapse collapse" data-bs-parent="#waitlistAccordion">
                                <div class="accordion-body bg-white p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover mb-0 align-middle">
                                            <thead class="table-light">
                                                <tr>
                                                    <th class="ps-4" style="width: 80px;">Pos</th>
                                                    <th>User</th>
                                                    <th>Email</th>
                                                    <th>Joined Date</th>
                                                    <th>Seats</th>
                                                    <th class="text-end pe-4">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @{
                                                    int pos = 1;
                                                }
                                                @foreach (var user in group.Entries)
                                                {
                                                    <tr>
                                                        <td class="ps-4">
                                                            <div class="avatar-circle-sm">@pos</div>
                                                        </td>
                                                        <td class="fw-bold text-primary">@user.UserName</td>
                                                        <td class="text-muted">@user.UserEmail</td>
                                                        <td class="small text-muted">@user.JoinedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                                        <td>
                                                            <span class="badge bg-info text-dark">@user.RequestedAmount</span>
                                                        </td>
                                                        <td class="text-end pe-4">
                                                            <form asp-action="RemoveFromWaitlist" method="post" onsubmit="return confirm('Remove @user.UserName from the list?');">
                                                                <input type="hidden" name="waitlistId" value="@user.WaitlistId" />
                                                                <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="Remove User">
                                                                    <i class="bi bi-trash-fill"></i> Remove
                                                                </button>
                                                            </form>
                                                        </td>
                                                    </tr>
                                                    pos++;
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </main>
    </div>
</div>